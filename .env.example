# Server-only AI configuration
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase. The URL is public by design; the service role key must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email and internal-report delivery
RESEND_API_KEY=
BRIEF_FROM_EMAIL=Neora Labs <hola@neoralabs.eu>
INTERNAL_REPORT_EMAIL=hola@neoralabs.eu

# Canonical application URL
NEXT_PUBLIC_APP_URL=https://neoralabs.eu
